#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D native_depth;
layout(set=0,binding=1,std430) buffer Pyramid {uint words[];} pyramid;
layout(push_constant,std430) uniform Params{uint width;uint height;uint a;uint b;} pc;
void main(){uvec2 p=gl_GlobalInvocationID.xy;if(p.x>=128u||p.y>=64u)return;
float d=0.0;if(p.x<pc.width&&p.y<pc.height)d=texelFetch(native_depth,ivec2(p),0).r;
pyramid.words[4u+p.y*128u+p.x]=floatBitsToUint(d);}
