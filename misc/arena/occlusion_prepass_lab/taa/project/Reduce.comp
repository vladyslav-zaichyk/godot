#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) buffer Pyramid{uint words[];} pyramid;
layout(push_constant,std430) uniform Params{uvec4 source;uvec4 destination;} pc;
void main(){uvec2 p=gl_GlobalInvocationID.xy;if(p.x>=pc.destination.y||p.y>=pc.destination.z)return;
float d=1.0;for(uint y=0u;y<2u;y++)for(uint x=0u;x<2u;x++){
uvec2 q=p*2u+uvec2(x,y);float s=0.0;if(q.x<pc.source.y&&q.y<pc.source.z)s=uintBitsToFloat(pyramid.words[pc.source.x+q.y*pc.source.y+q.x]);d=min(d,s);}
pyramid.words[pc.destination.x+p.y*pc.destination.y+p.x]=floatBitsToUint(d);}
