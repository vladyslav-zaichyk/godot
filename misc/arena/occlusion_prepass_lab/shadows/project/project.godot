config_version=5
[application]
config/name="E13e Directional Shadow Contract"
run/main_scene="res://Main.tscn"
run/flush_stdout_on_print=true
[display]
window/size/viewport_width=96
window/size/viewport_height=64
window/vsync/vsync_mode=0
[dotnet]
project/assembly_name="ShadowContractLab"
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0,0,0,1)
