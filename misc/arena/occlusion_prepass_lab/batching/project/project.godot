config_version=5
[application]
config/name="E13d Ordinary Opaque Batching Contract"
run/main_scene="res://Main.tscn"
run/flush_stdout_on_print=true
[display]
window/size/viewport_width=128
window/size/viewport_height=64
window/vsync/vsync_mode=0
[dotnet]
project/assembly_name="BatchingLab"
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0,0,0,1)
