#version 450
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D depth_texture;
layout(set=0,binding=1,std430) buffer Pyramid { uint words[]; } pyramid;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= 64u || p.y >= 32u) return;
    pyramid.words[4u + p.y * 64u + p.x] = floatBitsToUint(texelFetch(depth_texture, ivec2(p), 0).r);
}
